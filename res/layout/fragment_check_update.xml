<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xxl">

        <!-- Hero Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/hero_padding_vertical">

            <!-- Hero Icon with container -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="?attr/colorPrimaryContainer"
                android:gravity="center">

                <ImageView
                    android:id="@+id/heroIcon"
                    android:layout_width="@dimen/hero_icon_size"
                    android:layout_height="@dimen/hero_icon_size"
                    android:src="@drawable/ic_cloud_large"
                    app:tint="?attr/colorOnPrimaryContainer" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold"
                android:text="@string/status_checking"
                android:letterSpacing="-0.02"
                android:textAlignment="center" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAlignment="center"
                tools:text="Checking..." />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/downloadBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:max="100"
                android:progressTint="?attr/colorPrimary"
                android:visibility="gone" />

            <!-- Last Checked -->
            <TextView
                android:id="@+id/txtLastChecked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg">
            
            <!-- Export Button (Text) -->
            <Button
                android:id="@+id/btnExport"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_small"
                android:visibility="gone"
                android:text="@string/export_button"
                android:textAllCaps="false" />

            <!-- Download Button (Filled) -->
            <Button
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:visibility="gone"
                android:text="@string/btn_download"
                android:textAllCaps="false"
                android:elevation="2dp" />

            <!-- Check Button (Outlined) -->
            <Button
                android:id="@+id/btnCheck"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/btn_check"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Available Build Section -->
        <TextView
            android:id="@+id/sepAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_sm"
            android:text="@string/sep_available"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="-0.01"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            android:visibility="gone">
            
            <androidx.core.widget.NestedScrollView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent">
                <LinearLayout 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:orientation="vertical" 
                    android:padding="@dimen/card_padding_h">
                    
                    <!-- Version -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_version" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowRemoteVersion" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Build Date -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_build_date" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowBuildDate" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Size -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_size" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowDownloadSize" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Android Version -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_android" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowRemoteAndroid" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Security Patch -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_patch" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowRemoteSecurity" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Fingerprint -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_fingerprint" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowRemoteFingerprint" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Integrity -->
                    <TextView
                        android:id="@+id/txtIntegrity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="?attr/colorPrimaryContainer"
                        android:padding="@dimen/spacing_md"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Changelog Section -->
        <TextView
            android:id="@+id/sepChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_sm"
            android:text="@string/sep_changelog"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="-0.01"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            android:visibility="gone">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_padding_h"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:lineSpacingExtra="4dp" />

                <Button
                    android:id="@+id/btnCopyChangelog"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/btn_copy_changelog"
                    android:textAllCaps="false"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- System Diagnostics Section -->
        <TextView
            android:id="@+id/sepSlotStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_sm"
            android:text="@string/diag_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="-0.01" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSlotStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
            
            <androidx.core.widget.NestedScrollView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent">
                <LinearLayout 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:orientation="vertical" 
                    android:padding="@dimen/card_padding_h">
                    
                    <!-- Layout Type -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/diag_layout" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowLayoutType" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_md"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Active Slot -->
                    <TextView 
                        android:id="@+id/lblActiveSlot" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/diag_slot" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowActiveSlot" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- This Device Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_sm"
            android:text="@string/sep_device"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="-0.01" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
            
            <androidx.core.widget.NestedScrollView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent">
                <LinearLayout 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:orientation="vertical" 
                    android:padding="@dimen/card_padding_h">
                    
                    <!-- Installed Version -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_installed" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowInstalledVersion" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Model -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_model" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowDeviceModel" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Android Version -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_android" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowAndroid" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Security Patch -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_patch" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowSecurity" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Fingerprint -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_fingerprint" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowFingerprint" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                    
                    <!-- Kernel -->
                    <TextView 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:text="@string/f_kernel" 
                        android:textStyle="bold" 
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="@dimen/spacing_xs" />
                    <TextView 
                        android:id="@+id/rowKernel" 
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB for Local Update -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLocalUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin_bottom"
        app:srcCompat="@drawable/ic_launcher_foreground"
        app:tint="?attr/colorOnPrimaryContainer"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:contentDescription="@string/local_update" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
