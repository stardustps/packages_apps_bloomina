<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xxl">

        <!-- Maintainer Hero Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/hero_padding_vertical">

            <!-- Avatar Container -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="?attr/colorPrimaryContainer"
                android:gravity="center">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_cloud_large"
                    android:contentDescription="@string/tab_maintainer" />
            </FrameLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold"
                tools:text="aerocat"
                android:letterSpacing="-0.02" />

            <!-- Handle -->
            <TextView
                android:id="@+id/handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="\@aerocat" />
        </LinearLayout>

        <!-- Details Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_sm"
            android:text="@string/sep_details"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="-0.01" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
            
            <LinearLayout 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:orientation="vertical" 
                android:padding="@dimen/card_padding_h">
                
                <!-- ROM -->
                <TextView 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="@string/f_rom" 
                    android:textStyle="bold" 
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="@dimen/spacing_xs" />
                <TextView 
                    android:id="@+id/rom" 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:paddingBottom="@dimen/spacing_md"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
                
                <!-- Device -->
                <TextView 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="@string/f_device" 
                    android:textStyle="bold" 
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="@dimen/spacing_xs" />
                <TextView 
                    android:id="@+id/device" 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contact Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_sm"
            android:text="@string/sep_contact"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="-0.01" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/corner_lg"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
            
            <LinearLayout 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:orientation="vertical">
                
                <!-- Telegram -->
                <TextView
                    android:id="@+id/btnTelegram"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_height"
                    android:paddingHorizontal="@dimen/list_item_padding"
                    android:gravity="center_vertical"
                    android:text="@string/btn_telegram"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorPrimary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <!-- GitHub -->
                <TextView
                    android:id="@+id/btnGithub"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_height"
                    android:paddingHorizontal="@dimen/list_item_padding"
                    android:gravity="center_vertical"
                    android:text="GitHub"
                    android:visibility="gone"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorPrimary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
                <View 
                    android:id="@+id/divGithub" 
                    android:layout_width="match_parent" 
                    android:layout_height="1dp" 
                    android:background="?attr/colorOutlineVariant" 
                    android:visibility="gone" />

                <!-- XDA -->
                <TextView
                    android:id="@+id/btnXda"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_height"
                    android:paddingHorizontal="@dimen/list_item_padding"
                    android:gravity="center_vertical"
                    android:text="XDA Thread"
                    android:visibility="gone"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorPrimary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
                <View 
                    android:id="@+id/divXda" 
                    android:layout_width="match_parent" 
                    android:layout_height="1dp" 
                    android:background="?attr/colorOutlineVariant" 
                    android:visibility="gone" />

                <View 
                    android:layout_width="match_parent" 
                    android:layout_height="1dp" 
                    android:background="?attr/colorOutlineVariant" />

                <!-- Donate -->
                <TextView
                    android:id="@+id/btnDonate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_height"
                    android:paddingHorizontal="@dimen/list_item_padding"
                    android:gravity="center_vertical"
                    android:text="@string/btn_donate"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorPrimary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
