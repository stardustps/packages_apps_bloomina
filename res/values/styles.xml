<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title styles -->
    <style name="bloomina.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="letterSpacing">-0.01</item>
    </style>

    <style name="bloomina.Text.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="letterSpacing">-0.02</item>
    </style>

    <!-- Body styles -->
    <style name="bloomina.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="letterSpacing">0.01</item>
    </style>

    <style name="bloomina.Text.BodyBold" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Label styles -->
    <style name="bloomina.Text.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="letterSpacing">0.04</item>
    </style>

    <style name="bloomina.Text.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="letterSpacing">0.02</item>
    </style>

    <!-- Navigation label styles -->
    <style name="TextAppearance.bloomina.Label.Active" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.bloomina.Label.Inactive" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Toolbar text styles -->
    <style name="TextAppearance.bloomina.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">20sp</item>
        <item name="letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.bloomina.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
