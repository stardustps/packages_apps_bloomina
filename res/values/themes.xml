<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure Material 3 (Dynamic Color) theme. No glassmorphism: depth is expressed with
         tonal surface colors, not transparent fills or shadows. -->
    <style name="Theme.bloomina" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/google_sans_flex</item>
        <item name="fontFamily">@font/google_sans_flex</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
