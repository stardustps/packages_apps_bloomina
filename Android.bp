//
// Build configuration for Bloomina Updater (AOSP/LineageOS)
//
// UI rewritten in Jetpack Compose (Material 3, M3 Expressive). The Compose Kotlin
// compiler plugin (androidx.compose.compiler_compiler) is applied automatically by Soong
// once the Compose runtime below is on the classpath — ensure your tree provides the
// Compose prebuilts.
//

android_app {
    name: "bloomina",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "src/**/*.aidl",
    ],

    resource_dirs: ["res"],

    manifest: "AndroidManifest.xml",

    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.activity_activity-compose",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-text",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.material3_material3-window-size-class",
        "androidx.compose.material_icons-extended",
        "androidx.navigation_navigation-compose",
        "kotlinx_coroutines_android",
        "com.google.android.material_material",
        "SettingsLib",
    ],

    optimize: {
        enabled: true,
    },

    required: [
        "privapp_whitelist_com.Zerodactyl.bloomina",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.Zerodactyl.bloomina",
    sub_dir: "permissions",
    src: "privapp-permissions-bloomina.xml",
    filename_from_src: true,
    system_ext_specific: true,
}
