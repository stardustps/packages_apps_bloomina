//
// Build configuration for Bloomina Updater (AOSP/LineageOS)
//

android_app {
    name: "bloomina",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        "src/**/*.aidl",
    ],

    resource_dirs: ["res"],

    manifest: "AndroidManifest.xml",

    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.fragment_fragment-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-ktx",
        "kotlinx_coroutines_android",
        "com.google.android.material_material",
        "SettingsLib",
        // libsu provides com.topjohnwu.superuser (Shell, RootService, ipc).
        // Module name assumes a standard tree (external/libsu -> "libsu").
        // Adjust to your tree's prebuilt name if it differs.
        "libsu",
        // Note: okhttp and gson might require prebuilts or source drops
        // depending on your LineageOS tree version.
        // "okhttp",
        // "gson",
    ],

    optimize: {
        enabled: true,
        proguard_flags_files: ["proguard-rules.pro"],
    },

    required: [
        "privapp_whitelist_com.Zerodactyl.bloomina",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.Zerodactyl.bloomina",
    sub_dir: "permissions",
    src: "privapp-permissions-bloomina.xml",
    filename_from_src: true,
    system_ext_specific: true,
}
